# Supabase (Auth + Postgres + license vault). Leave blank to run catalog + mock checkout locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Drift

# Payments: mock | stripe
# mock = instant license + download (great for demos). stripe = real Checkout when keys are set.
PAYMENT_GATEWAY=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: email delivery of license keys (Resend free tier)
RESEND_API_KEY=
LICENSE_FROM_EMAIL=licenses@drift.local
LICENSE_SIGNING_SECRET=
